{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "**/*",
      "!.agents",
      "!.claude",
      "!scripts",
      "!apps/codex-sidebar-demo/.vite",
      "!apps/codex-sidebar-demo/out",
      "!apps/storybook/public/mockServiceWorker.js",
      "!packages/ui/src/components/ui",
      "!packages/ui/src/hooks",
      "!packages/ui/src/lib",
      "!packages/ui-v2/src/components/ai-elements",
      "!packages/ui-v2/src/components/ui",
      "!packages/ui-v2/src/hooks",
      "!packages/ui-v2/src/lib",
      "!packages/app-api-contract/openapi.json",
      "!db/app/src/migrations",
      "!**/routeTree.gen.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noUselessReturn": "off",
        "noVoid": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "performance": {
        "noBarrelFile": "off",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "noExportedImports": "off",
        "noIncrementDecrement": "off",
        "noNestedTernary": "off",
        "noNonNullAssertion": "off",
        "noParameterProperties": "off",
        "useDestructuring": "off",
        "useConsistentMemberAccessibility": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noBitwiseOperators": "off",
        "noEvolvingTypes": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noLeakedRender": "off",
        "noEqualsToNull": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useAwait": "off"
      }
    }
  }
}
