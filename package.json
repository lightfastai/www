{
  "name": "@lightfastai/www-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "audit": "pnpm audit --prod --audit-level high",
    "boundaries": "turbo boundaries",
    "build": "SKIP_ENV_VALIDATION=true turbo run build -F @lightfast/www",
    "check": "ultracite check",
    "clean": "git clean -xdf node_modules",
    "dev": "SKIP_ENV_VALIDATION=true turbo run dev --filter=@lightfast/www --concurrency=2",
    "test": "SKIP_ENV_VALIDATION=true turbo run test -F @lightfast/www",
    "typecheck": "SKIP_ENV_VALIDATION=true turbo run typecheck",
    "verify": "pnpm check && pnpm test && pnpm typecheck && pnpm build && pnpm boundaries && pnpm audit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "portless": "catalog:",
    "turbo": "2.10.12",
    "turbo-ignore": "2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  }
}
